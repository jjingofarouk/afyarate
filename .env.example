# Copy to .env.local and fill in values (never commit .env.local)

# Supabase project (Dashboard → Connect → Next.js)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_XXXX

# Secret — used only by scripts/setup_supabase.mjs and scripts/import_supabase.mjs
# (Dashboard → Connect → Session pooler; IPv4, works from any network)
SUPABASE_DB_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@aws-1-REGION.pooler.supabase.com:5432/postgres
