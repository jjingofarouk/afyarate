# Copy to .env.local and fill in values (never commit .env.local)

# Supabase project (Dashboard → Connect → Next.js)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_XXXX

# Secret — used only by scripts/setup_supabase.mjs and scripts/import_supabase.mjs
# (Dashboard → Connect → Session pooler; IPv4, works from any network)
SUPABASE_DB_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@aws-1-REGION.pooler.supabase.com:5432/postgres

# ---- Admin panel (app/admin) ------------------------------------------------
# The passcode you type at /admin/login. Keep it long & unique.
#  - Local dev: put it in .env.local
#  - Cloudflare: `wrangler secret put ADMIN_PASSCODE`
ADMIN_PASSCODE=change-me-to-a-long-random-passcode

# Service-role key — lets the admin panel read/update/delete posts & photos
# (bypasses Row Level Security). Server-only; NEVER expose to the browser.
# (Dashboard → Project Settings → API → service_role secret)
#  - Local dev: put it in .env.local
#  - Cloudflare: `wrangler secret put SUPABASE_SERVICE_ROLE_KEY`
SUPABASE_SERVICE_ROLE_KEY=eyJ...service_role...  # legacy JWT key, or sb_secret_... (new keys)

