# Committed on purpose: these are PUBLIC values required at build time.
# The Supabase publishable key is designed to be public (used in client code).
# The secret SUPABASE_DB_URL lives only in .env.local (gitignored).
NEXT_PUBLIC_SUPABASE_URL=https://idishukmepvkzyguhxnm.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_K3Iq2I86zdnZrXmiLDFM7g_kOTg3yOq

# Canonical production origin. Used for canonical tags, the sitemap, Open Graph
# URLs and the emails sent by scripts/. Supabase "Redirect URLs" must include
# https://medicalopportunities.ug/** so auth emails return here, not localhost.
NEXT_PUBLIC_SITE_URL=https://medicalopportunities.ug
